{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits"],
  "enabledManagers": ["npm"],
  "timezone": "Europe/Paris",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "labels": ["dependencies"]
}
