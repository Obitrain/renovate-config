{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Obitrain/renovate-config"],
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies", "engines"],
      "enabled": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "!react",
        "!react-*",
        "!@types/react",
        "!@types/react-*",
        "!@react-native/*",
        "!@react-native-community/*",
        "!@shopify/react-native-*",
        "!expo",
        "!expo-*",
        "!babel-preset-expo",
        "!nitrogen",
        "!turbo"
      ],
      "groupName": "dev tooling",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "react",
        "react-*",
        "@types/react",
        "@types/react-*",
        "@react-native-community/*",
        "@shopify/react-native-*",
        "!react-native-builder-bob",
        "!react-native-nitro-modules"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["react-native-builder-bob", "turbo"],
      "automerge": false
    },
    {
      "matchPackageNames": ["nitrogen", "react-native-nitro-modules"],
      "groupName": "nitro",
      "automerge": false
    },
    {
      "matchPackageNames": ["react-native", "@react-native/*", "@react-native-community/cli*"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["major-bump"]
    }
  ]
}
